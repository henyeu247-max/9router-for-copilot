{
  "name": "9router-for-github-copilot",
  "displayName": "9Router for GitHub Copilot Chat",
  "description": "%ext.description%",
  "version": "3.0.0",
  "publisher": "henyeu247-max",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/henyeu247-max/9router-for-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/henyeu247-max/9router-for-copilot/issues"
  },
  "homepage": "https://github.com/henyeu247-max/9router-for-copilot",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "9router",
    "copilot",
    "github-copilot",
    "byok",
    "openai-compatible",
    "llm",
    "ai",
    "chat",
    "gateway",
    "router",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "kimi",
    "glm",
    "qwen",
    "ollama",
    "agent-mode",
    "tool-calling",
    "vision",
    "thinking"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nine-router",
          "title": "9Router",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "nine-router": [
        {
          "type": "webview",
          "id": "nine-router.panel",
          "name": "%view.connection%",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "9router-github-copilot",
        "displayName": "9Router",
        "managementCommand": "9router-for-github-copilot.manage"
      }
    ],
    "commands": [
      {
        "command": "9router-for-github-copilot.manage",
        "title": "%cmd.manage%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.addProvider",
        "title": "%cmd.addProvider%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.testConnection",
        "title": "%cmd.testConnection%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.refreshModels",
        "title": "%cmd.refreshModels%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.editCustomHeaders",
        "title": "%cmd.editCustomHeaders%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.selectInlineCompletionModel",
        "title": "%cmd.selectInlineCompletionModel%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.showOutput",
        "title": "%cmd.showOutput%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.quickActions",
        "title": "%cmd.quickActions%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.openDashboard",
        "title": "%cmd.openDashboard%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.openSettings",
        "title": "%cmd.openSettings%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.openRequestDumps",
        "title": "%cmd.openRequestDumps%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.clearApiKey",
        "title": "%cmd.clearApiKey%",
        "category": "9Router"
      },
      {
        "command": "9router-for-github-copilot.showPanel",
        "title": "%cmd.showPanel%",
        "category": "9Router"
      }
    ],
    "configuration": {
      "title": "9Router",
      "properties": {
        "9router-for-github-copilot.serverUrl": {
          "type": "string",
          "default": "http://localhost:20128/v1",
          "description": "%cfg.serverUrl%",
          "order": 1
        },
        "9router-for-github-copilot.apiKey": {
          "type": "string",
          "default": "",
          "description": "%cfg.apiKey%",
          "deprecationMessage": "API keys are now stored in VS Code's secret storage. Use the '9Router: Manage Providers' command to set the API key.",
          "order": 2
        },
        "9router-for-github-copilot.requestTimeout": {
          "type": "number",
          "default": 60000,
          "description": "%cfg.requestTimeout%",
          "order": 3
        },
        "9router-for-github-copilot.defaultMaxTokens": {
          "type": "number",
          "default": 262144,
          "description": "%cfg.defaultMaxTokens%",
          "order": 4
        },
        "9router-for-github-copilot.defaultMaxOutputTokens": {
          "type": "number",
          "default": 4096,
          "description": "%cfg.defaultMaxOutputTokens%",
          "order": 5
        },
        "9router-for-github-copilot.enableImageInput": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.enableImageInput%",
          "order": 6
        },
        "9router-for-github-copilot.visionProxyEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.visionProxyEnabled%",
          "order": 6.1
        },
        "9router-for-github-copilot.visionProxyModel": {
          "type": "string",
          "default": "",
          "description": "%cfg.visionProxyModel%",
          "order": 6.2
        },
        "9router-for-github-copilot.encodeSlashInModelId": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.encodeSlashInModelId%",
          "order": 6.3
        },
        "9router-for-github-copilot.modelFilter": {
          "type": "string",
          "default": "",
          "description": "%cfg.modelFilter%",
          "order": 6.4
        },
        "9router-for-github-copilot.enableToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.enableToolCalling%",
          "order": 7
        },
        "9router-for-github-copilot.parallelToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.parallelToolCalling%",
          "order": 8
        },
        "9router-for-github-copilot.agentTemperature": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2,
          "description": "%cfg.agentTemperature%",
          "order": 9
        },
        "9router-for-github-copilot.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.verboseLogging%",
          "deprecationMessage": "%cfg.verboseLogging.deprecated%",
          "order": 10
        },
        "9router-for-github-copilot.customHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "%cfg.customHeaders%",
          "deprecationMessage": "Custom headers (which may carry credentials such as 'Authorization') are now stored in VS Code's secret storage. Use the '9Router: Edit Custom Headers' command.",
          "order": 11
        },
        "9router-for-github-copilot.extraModelOptions": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "%cfg.extraModelOptions%",
          "order": 12
        },
        "9router-for-github-copilot.perModelOptions": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "%cfg.perModelOptions%",
          "order": 13
        },
        "9router-for-github-copilot.probeThinkingLevels": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.probeThinkingLevels%",
          "order": 6.5
        },
        "9router-for-github-copilot.enableInlineCompletion": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.enableInlineCompletion%",
          "order": 14
        },
        "9router-for-github-copilot.inlineCompletionProvider": {
          "type": "string",
          "default": "",
          "description": "%cfg.inlineCompletionProvider%",
          "order": 15
        },
        "9router-for-github-copilot.inlineCompletionModel": {
          "type": "string",
          "default": "",
          "description": "%cfg.inlineCompletionModel%",
          "order": 16
        },
        "9router-for-github-copilot.inlineCompletionMaxTokens": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "%cfg.inlineCompletionMaxTokens%",
          "order": 17
        },
        "9router-for-github-copilot.inlineCompletionDebounce": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "%cfg.inlineCompletionDebounce%",
          "order": 18
        },
        "9router-for-github-copilot.inlineCompletionTimeout": {
          "type": "number",
          "default": 3000,
          "minimum": 1,
          "description": "%cfg.inlineCompletionTimeout%",
          "order": 19
        },
        "9router-for-github-copilot.inlineCompletionMaxPrefixChars": {
          "type": "number",
          "default": 4000,
          "minimum": 1,
          "description": "%cfg.inlineCompletionMaxPrefixChars%",
          "order": 20
        },
        "9router-for-github-copilot.modelContextWindows": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number"
          },
          "description": "%cfg.modelContextWindows%",
          "order": 20.5
        },
        "9router-for-github-copilot.inlineCompletionMaxSuffixChars": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "%cfg.inlineCompletionMaxSuffixChars%",
          "order": 21
        },
        "9router-for-github-copilot.statusBar": {
          "type": "boolean",
          "default": true,
          "order": 40,
          "description": "%cfg.statusBar%"
        },
        "9router-for-github-copilot.healthCheckIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "order": 41,
          "description": "%cfg.healthCheckIntervalSeconds%"
        },
        "9router-for-github-copilot.dashboardOpen": {
          "type": "string",
          "enum": [
            "external",
            "editor"
          ],
          "default": "external",
          "order": 42,
          "description": "%cfg.dashboardOpen%"
        },
        "9router-for-github-copilot.dashboardUrl": {
          "type": "string",
          "default": "",
          "order": 43,
          "description": "%cfg.dashboardUrl%"
        },
        "9router-for-github-copilot.debugMode": {
          "type": "string",
          "enum": [
            "off",
            "metadata",
            "verbose"
          ],
          "default": "off",
          "order": 10.5,
          "description": "%cfg.debugMode%",
          "enumDescriptions": [
            "%cfg.debugMode.off%",
            "%cfg.debugMode.metadata%",
            "%cfg.debugMode.verbose%"
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --no-dependencies -o 9router-for-github-copilot.vsix",
    "smoke": "npm run package && node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.0.0"
  }
}
